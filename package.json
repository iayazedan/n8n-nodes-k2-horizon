{
	"name": "n8n-nodes-k2-horizon",
	"version": "0.1.1",
	"description": "n8n community node for K2 Horizon (IFM) — a chat model for the AI Agent plus a node for direct calls, with native tool calling, reasoning effort and structured output",
	"license": "MIT",
	"homepage": "https://github.com/iayazedan/n8n-nodes-k2-horizon",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"k2-horizon",
		"k2horizon",
		"ifm",
		"mbzuai",
		"llm",
		"ai",
		"agent",
		"tool-calling",
		"chat-model"
	],
	"author": {
		"name": "Aya Sayed",
		"email": "i.ayazedan@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/iayazedan/n8n-nodes-k2-horizon.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"pretest": "npm run build",
		"test": "node --test test/*.test.js",
		"test:live": "node --test test/live.test.js"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"aiNodeSdkVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/K2HorizonApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/K2Horizon/K2Horizon.node.js",
			"dist/nodes/K2HorizonChatModel/K2HorizonChatModel.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*",
		"@n8n/ai-node-sdk": "*"
	}
}
